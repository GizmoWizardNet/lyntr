#DISCORD CONFIG for the useful bot and verifications, as well as banning and unbanning
DISCORD_CLIENT_SECRET="client-secret-OAUTH2"
PUBLIC_DISCORD_CLIENT_ID="client-id-OAUTH2"

DISCORD_BOT_TOKEN="very-very-secret-token-for-the-bot" # Bot token for the bot to use to send messages and verify users
DISCORD_CHANNEL_ID="channel-id" # Channel to send reports to

ADMIN_KEY="just-any-key" # Key to communicate between the API and the bot. Required for endpoint /verify & /ban
API_BASE_URL="https://lyntr.gizmowizard.tech" # The API URL (usually port 5173 if local, main domain if production)

SUDO_USER_ID="linus_sudo" # The (valid) Lyntr user ID to use as an "agent" when fetching Lynt content for reporting. (since views must count regardless)
DISCORD_ADMIN_ROLE="role-id" # Only users with this role can use /verify or ban users.

DISCORD_LOG_CHANNEL_ID="same-channel-id-as-above" # Channel to send logs to (e.g. user verification, bans, etc.)
DISCORD_STATS_CHANNEL_ID="same-channel-id-as-above" # Channel to send daily anon stats to (e.g. user verification, bans, etc.)
API_BASE_URL="http://website:5999" #containerized name
PUBLIC_ORIGIN="https://lyntr.gizmowizard.tech" #production domain

#Build-time commit hash shown on the /developer and About pages. Docker sets
#this automatically (see Dockerfile/compose.yml); for local `npm run dev` or
#`npm run check`, set it to your current commit (e.g. `git rev-parse --short HEAD`).
PUBLIC_GIT_COMMIT="unknown"