#GOOGLE for secondary auth
PUBLIC_GOOGLE_CLIENT_ID="client_id37487shitbang.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-whatever"

#OPENROUTER CONTENT MODERATION— set MODERATION=false to disable entirely
MODERATION=true
OPENROUTER_API_KEY=sk-or-v1-api-key

# ── Scrollables (separate MinIO instance, e.g. a Raspberry Pi exposed via
# Cloudflare Tunnel) — kept fully separate from the main image/avatar CDN
# above so scrollables storage can live on different hardware and storage most importantly cuz the VPS hasn't fuck-all space for video processing

SCROLLABLES_MINIO_ENDPOINT="scrollables-lyntr-cdn.gizmowizard.tech" # or the Pi's LAN IP if this app runs on the same network. Use exposed DNS name through cloudflare if NOT on the same network
SCROLLABLES_MINIO_PORT="443" # 443 for the tunnel (HTTPS); 9000 if talking to MinIO directly over LAN
SCROLLABLES_MINIO_USE_SSL="true" # set to "false" for a plain-HTTP LAN connection
SCROLLABLES_MINIO_ACCESS_KEY="access-uWu"
SCROLLABLES_MINIO_SECRET_KEY="secret-uWu"
SCROLLABLES_S3_BUCKET_NAME="scrollables"

# Public — must match SCROLLABLES_MINIO_ENDPOINT's public-facing scheme+host
# and SCROLLABLES_S3_BUCKET_NAME above. This is what the browser fetches
# video/thumbnail files from directly, so it has to be reachable from the
# public internet (the Cloudflare Tunnel hostname), not a LAN address.
PUBLIC_SCROLLABLES_CDN_URL="https://scrollables-lyntr-cdn.gizmowizard.tech"
PUBLIC_SCROLLABLES_BUCKET_NAME="scrollables"

#EMAIL Notifications
RESEND_API_KEY=key
EMAIL_FROM="Lyntr <notifs@lyntr.example.com>"

#VAPID KEYS for Web Push notifs
VAPID_PUBLIC_KEY=generated-public-key
VAPID_PRIVATE_KEY=generated-private-key
VAPID_SUBJECT=mailto:your-email@gmail.com

#KLIPY for GIFs
KLIPY_API_KEY=klipy-api-key

#CLOUDFLARE for Turnstile CAPTCHA security on Account Creation
PUBLIC_TURNSTILE_SITE_KEY="cloudflare thunder boom boom"
TURNSTILE_SECRET_KEY="gahh"

#SUPABASE for THE DB duh
DATABASE_URL="FULL CONNECTION URL FROM SUPABASE"
JWT_SECRET="random signing secret"

#MINIO ACCESS creds for all things S3
MINIO_ACCESS_KEY="main-minio"
MINIO_SECRET_KEY="fuckgeffedbedeebdmw"

#RATELIMIT settings
RATELIMIT_SENSITIVE_REQUESTS=1
RATELIMIT_SENSITIVE_WINDOW=10 s

#RUGPLAY key used for global requests(get from rugplay.com)
RUGPLAY_API_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAA

#UPSTASH for Redis
UPSTASH_REDIS_REST_URL="UPSTASH REDIS REST URL"
UPSTASH_REDIS_REST_TOKEN="REST_TOKEN_WHICH_IS_NOT_READ_ONLY"

#CLOUDFLARED TUNNEL for securing stuff up and also for use where CGNAT is present
