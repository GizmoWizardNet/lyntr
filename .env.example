#SUPABASE project ID and ANON key(legacy now, but do not dare to change it for the new system because it works)
PUBLIC_SUPABASE_URL="AAAAAAAAAAAAAAAAAAAAAAAAAAA.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="kwedjwefbdec-uewweufugf32uf2ufu2fugjweddyeahalolbitch"

#MAIN MINIO section, since docker handles shit the minio endpoint is the container name
